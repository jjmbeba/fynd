{
  "openapi": "3.1.0",
  "info": {
    "title": "Fynd",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/catalog/stores": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List observed stores",
        "operationId": "list_stores_api_v1_catalog_stores_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StoreRead"
                  },
                  "type": "array",
                  "title": "Response List Stores Api V1 Catalog Stores Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/deals": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List current deals",
        "operationId": "list_deals_api_v1_catalog_deals_get",
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Store"
            }
          },
          {
            "name": "max_kes_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Kes Price"
            }
          },
          {
            "name": "min_discount_percent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Discount Percent"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DealRead"
                  },
                  "title": "Response List Deals Api V1 Catalog Deals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/free-games": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List currently free games",
        "operationId": "list_free_games_api_v1_catalog_free_games_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FreeGameRead"
                  },
                  "type": "array",
                  "title": "Response List Free Games Api V1 Catalog Free Games Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/refresh": {
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Trigger immediate scrape of all active stores",
        "operationId": "trigger_refresh_api_v1_catalog_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/health": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get the most recent scrape state per store",
        "operationId": "get_health_api_v1_catalog_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogHealth"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogHealth": {
        "properties": {
          "stores": {
            "items": {
              "$ref": "#/components/schemas/StoreScrapeStatus"
            },
            "type": "array",
            "title": "Stores"
          }
        },
        "type": "object",
        "required": [
          "stores"
        ],
        "title": "CatalogHealth"
      },
      "DealRead": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "listing_id": {
            "type": "integer",
            "title": "Listing Id"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "store_slug": {
            "type": "string",
            "title": "Store Slug"
          },
          "store_display_name": {
            "type": "string",
            "title": "Store Display Name"
          },
          "base_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Base Amount"
          },
          "native_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Native Amount"
          },
          "kes_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Kes Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "discount_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount Percent"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "listing_id",
          "image_url",
          "store_slug",
          "store_display_name",
          "base_amount",
          "native_amount",
          "kes_amount",
          "currency",
          "discount_percent",
          "observed_at"
        ],
        "title": "DealRead"
      },
      "FreeGameRead": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "listing_id": {
            "type": "integer",
            "title": "Listing Id"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "store_slug": {
            "type": "string",
            "title": "Store Slug"
          },
          "store_display_name": {
            "type": "string",
            "title": "Store Display Name"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "base_amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Amount"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "listing_id",
          "image_url",
          "store_slug",
          "store_display_name",
          "currency",
          "base_amount",
          "observed_at"
        ],
        "title": "FreeGameRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RefreshStatus": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "stores": {
            "items": {
              "$ref": "#/components/schemas/StoreScrapeStatus"
            },
            "type": "array",
            "title": "Stores"
          }
        },
        "type": "object",
        "required": [
          "started_at",
          "stores"
        ],
        "title": "RefreshStatus"
      },
      "ScrapeStatus": {
        "type": "string",
        "enum": [
          "running",
          "success",
          "error"
        ],
        "title": "ScrapeStatus"
      },
      "StoreRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "display_name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "title": "StoreRead"
      },
      "StoreScrapeStatus": {
        "properties": {
          "store_slug": {
            "type": "string",
            "title": "Store Slug"
          },
          "status": {
            "$ref": "#/components/schemas/ScrapeStatus"
          },
          "listings_observed": {
            "type": "integer",
            "title": "Listings Observed"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "last_scrape_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Scrape At"
          }
        },
        "type": "object",
        "required": [
          "store_slug",
          "status",
          "listings_observed",
          "error_message",
          "started_at",
          "last_scrape_at"
        ],
        "title": "StoreScrapeStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
